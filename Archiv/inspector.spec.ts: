import { test, expect } from '@playwright/test';

test('Inspector overlay sichtbar & über iOS-Safe-Area', async ({ page }) => {
  await page.goto('http://localhost:8080'); // oder Pages-Preview-URL
  await page.click('#btn-inspector button');
  const overlay = page.locator('#inspector');
  await expect(overlay).toBeVisible();
  // sitzt ganzflächig
  await expect(overlay).toHaveCSS('position', 'fixed');
  await expect(overlay).toHaveCSS('z-index', /2147483/);
});

test('Logs zeigen mindestens 1 Zeile nach Start', async ({ page }) => {
  await page.goto('http://localhost:8080');
  await page.click('#btn-inspector button');
  await page.waitForTimeout(500);
  // Slot muss existieren
  const list = page.locator('#ins-logs-view .ins-logview > div');
  await expect(list).toHaveCountGreaterThan(0);
});
