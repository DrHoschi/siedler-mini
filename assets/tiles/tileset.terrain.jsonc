{
  // Atlas für 16x16 Tiles à 64px – Bild liegt neben der JSON
  "frames": {
    // Konvention: terrain_r{ROW}_c{COL}
    "terrain_r0_c0": { "x": 0, "y": 0, "w": 64, "h": 64 },
    // … (alle Einträge wie in der produktiven JSON – 256 Einträge) …
    "terrain_r15_c15": { "x": 960, "y": 960, "w": 64, "h": 64 }
  },

  // Platz für spätere Animationen (z. B. Wasser): "water_flow": ["terrain_r2_c5","terrain_r2_c6",...]
  "animations": {},

  "meta": {
    // WICHTIG: Dateiname, nicht URL – GameLoader hängt den Pfad der JSON davor.
    "image": "tileset.terrain.png",
    "tileSize": 64,               // Einheitliche Kantenlänge
    "size": { "w": 1024, "h": 1024 }, // Bildgröße
    "grid": { "cols": 16, "rows": 16 },
    "note": "Keys können in game.js auf sprechende Namen gemappt werden (z.B. grass, road0, rock)."
  }
}
