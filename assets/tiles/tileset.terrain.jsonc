{
  // v16.0.3 — Tileset-Atlas für 16x16 Kacheln à 64px = 1024x1024
  // Pfad-Auflösung: "image" ist RELATIV zu dieser JSON-Datei.
  "frames": {
    // Namensschema: terrain_r{ROW}_c{COL}
    // -> z.B. r4_c0: Wiese, r4_c1: Variante etc. (du kannst semantische Aliase später ergänzen)
    "terrain_r0_c0": { "x": 0,   "y": 0,   "w": 64, "h": 64 },
    "terrain_r0_c1": { "x": 64,  "y": 0,   "w": 64, "h": 64 },
    // ... (vollständig wie in der JSON oben, alle r0..r15, c0..c15)
    "terrain_r15_c15": { "x": 960, "y": 960, "w": 64, "h": 64 }
  },

  // Platz für spätere Animationen (nicht zwingend)
  "animations": {
    // "water_idle": ["terrain_r2_c5","terrain_r2_c6","terrain_r2_c7"]
  },

  "meta": {
    "image": "tileset.terrain.png",   // liegt im selben Ordner wie diese JSON
    "tileSize": 64,                   // Kantenlänge einer Kachel
    "size": { "w": 1024, "h": 1024 }, // Atlas-Gesamtgröße
    "grid": { "cols": 16, "rows": 16 },

    // Hinweis: Wenn ein Frame fehlt, solltest du in game.js auf
    // ./assets/tex/placeholder64.PNG zurückfallen (das hast du schon abgelegt).
    "note": "Generic grid mapping; rename or alias keys to semantic names as needed."
  }
}
