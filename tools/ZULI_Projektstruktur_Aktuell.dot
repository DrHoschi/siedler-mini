
digraph Projektstruktur {
  rankdir=LR;
  splines=true;
  overlap=false;
  fontname="Arial";
  node [shape=box, style=filled, fontname="Arial"];
  "core/asset.js" [label="asset.js", fillcolor="#cfe2ff"];
  "core/boot.js" [label="boot.js", fillcolor="#cfe2ff"];
  "core/registry.js" [label="registry.js", fillcolor="#cfe2ff"];
  "editor/editor.js" [label="editor.js", fillcolor="#ffe2b2"];
  "inspector/inspector.api-bridge.js" [label="inspector.api-bridge.js", fillcolor="#fce1ff"];
  "tools/debug-tools.js" [label="debug-tools.js", fillcolor="#d3f9d8"];
  "tools/texture-checker.html" [label="texture-checker.html", fillcolor="#d3f9d8"];
  "tools/dot-editor/dot-editor-pro.html" [label="dot-editor/dot-editor-pro.html", fillcolor="#d3f9d8"];
  "tools/siedler-node-playground.html" [label="siedler-node-playground.html", fillcolor="#d3f9d8"];
  "tools/map-editor-pro.html" [label="map-editor-pro.html", fillcolor="#d3f9d8"];
  "tools/level-editor/index.html" [label="level-editor/index.html", fillcolor="#d3f9d8"];
  "tools/code-block-editor.html" [label="code-block-editor.html", fillcolor="#d3f9d8"];
  "ui/ui-build.js" [label="ui-build.js", fillcolor="#fff3bf"];
  "ui/ui-buttons.js" [label="ui-buttons.js", fillcolor="#fff3bf"];
  "data/buildings.json" [label="buildings.json", fillcolor="#e0f7fa"];
  "data/units.json" [label="units.json", fillcolor="#e0f7fa"];
  "data/campaign.json" [label="campaign.json", fillcolor="#e0f7fa"];
  "data/balance.json" [label="balance.json", fillcolor="#e0f7fa"];
  "maps/map-mini-V0.json" [label="map-mini-V0.json", fillcolor="#e6e6e6"];
  "characters/char_sprite.json" [label="char_sprite.json", fillcolor="#f0f0f0"];
  "characters/char_sprite.png" [label="char_sprite.png", fillcolor="#f0f0f0"];
  "tiles/tileset.terrain.json" [label="tileset.terrain.json", fillcolor="#f8f9fa"];
  "tiles/tileset.png" [label="tileset.png", fillcolor="#f8f9fa"];
  "items/resources.json" [label="resources.json", fillcolor="#f5f5f5"];
  "index.html" [label="index.html", fillcolor="#dee2e6"];
  "README.md" [label="README.md", fillcolor="#dee2e6"];
  "index.html" -> "boot.js" [color="green", style="solid"];
  "boot.js" -> "registry.js" [color="green", style="solid"];
  "registry.js" -> "buildings.json" [color="green", style="solid"];
  "registry.js" -> "units.json" [color="green", style="solid"];
  "editor.js" -> "registry.js" [color="orange", style="solid"];
  "inspector.api-bridge.js" -> "editor.js" [color="orange", style="solid"];
  "debug-tools.js" -> "boot.js" [color="orange", style="solid"];
  "map-editor-pro.html" -> "maps" [color="orange", style="solid"];
  "level-editor/index.html" -> "maps" [color="orange", style="solid"];
  "code-block-editor.html" -> "core" [color="orange", style="solid"];
  "dot-editor-pro.html" -> "registry.js" [color="blue", style="dashed"];
  "siedler-node-playground.html" -> "registry.js" [color="blue", style="dashed"];
  "debug-tools.js" -> "registry.js" [color="blue", style="dashed"];
  "asset.js" -> "tileset.png" [color="green", style="solid"];
  "asset.js" -> "char_sprite.png" [color="green", style="solid"];
  "boot.js" -> "asset.js" [color="green", style="solid"];
  "ui-build.js" -> "registry.js" [color="orange", style="solid"];
  "ui-buttons.js" -> "boot.js" [color="orange", style="solid"];
}
