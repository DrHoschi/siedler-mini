
digraph ZULI_Projektstruktur {
  rankdir=LR;
  node [shape=box, style=filled, fillcolor="#f0f0f0"];

  subgraph cluster_klassen {
    label = "📦 Klassen";
    style=filled;
    color=lightblue;
    "AssetManager" [fillcolor="#cce5ff"];
    "BuildDock" [fillcolor="#cce5ff"];
